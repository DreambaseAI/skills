{
  "name": "@dreambase/mcp",
  "version": "0.1.0",
  "description": "Installer for the Dreambase MCP connection on clients without native remote-MCP OAuth (Claude Desktop, header-only harnesses): runs the OAuth 2.1 dance, stores tokens safely, writes client config pointing at the local shim, and installs the Dreambase skills.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreambaseAI/skills.git",
    "directory": "packages/mcp-installer"
  },
  "homepage": "https://github.com/DreambaseAI/skills/tree/main/packages/mcp-installer",
  "bugs": {
    "url": "https://github.com/DreambaseAI/skills/issues"
  },
  "keywords": [
    "dreambase",
    "mcp",
    "model-context-protocol",
    "oauth",
    "cli",
    "installer"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "dreambase-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:skills": "node scripts/sync-skills.mjs",
    "prepack": "npm run sync:skills && npm run build",
    "prepublishOnly": "npm run sync:skills && npm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.1.7",
    "commander": "^12.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  }
}
